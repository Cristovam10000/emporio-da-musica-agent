# Model used by the agent, in init_chat_model format: <provider>:<model>
# Default: Gemini on the free tier of Google AI Studio (no billing needed).
# Flash-Lite because its free tier allows 500 requests/day (vs 20/day for Flash);
# one customer message takes 2-3 model calls.
EMPORIO_MODEL=google_genai:gemini-3.5-flash-lite

# Free key: https://aistudio.google.com -> Get API key
GOOGLE_API_KEY=
